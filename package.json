{
  "name": "midas-contracts",
  "version": "2.0.0",
  "description": "",
  "license": "AGPL-3.0",
  "author": "RedDuck Software",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "sh -c '[ \"$NODE_ENV\" = \"production\" ] || husky install'",
    "precommit": "run-s codestyle",
    "hardhat": "hardhat",
    "clean": "hardhat clean",
    "docgen": "hardhat docgen",
    "compile": "hardhat compile",
    "build": "run-s clean compile",
    "test:unit": "hardhat test $(find test/unit -name \"*.test.ts\")",
    "test:unit:parallel": "yarn test:unit --parallel",
    "test:integration": "hardhat test $(find test/integration -name \"*.test.ts\")",
    "test": "run-p test:unit test:integration",
    "test:parallel": "run-s test:unit:parallel test:integration",
    "coverage": "cross-env COVERAGE=true hardhat coverage --solcoverjs ./.solcover.json --testfiles 'test/unit/*.test.ts'",
    "slither": "slither . --config-file ./slither.config.json",
    "slither:summary": "yarn slither --print human-summary --config-file ./slither.config.json",
    "deploy": "hardhat deploy",
    "lint:ts": "eslint \"**/*.{js,ts}\"",
    "lint:ts:fix": "eslint \"**/*.{js,ts}\" --fix",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint \"contracts/**/*.sol\" --quiet --fix",
    "format:ts": "prettier \"**/*.{js,ts,json}\" --check",
    "format:ts:fix": "prettier \"**/*.{js,ts,json}\" --write",
    "format:sol": "prettier \"contracts/**/*.sol\" --check",
    "format:sol:fix": "prettier \"contracts/**/*.sol\" --write",
    "format:yml": "prettier \"**/*.{yml,yaml}\" --check",
    "format:yml:fix": "prettier \"**/*.{yml,yaml}\" --write",
    "codestyle": "run-s \"lint:*\" \"format:*\"",
    "codestyle:fix": "run-s \"lint:*:*\" \"format:*:*\"",
    "hh:run": "yarn hardhat run",
    "hh:run:script": "yarn hardhat runscript",
    "deploy:lz:post:wire": "yarn hardhat lz:oapp:wire:midas",
    "verify:proxy": "yarn hardhat verify-transparent-proxy",
    "verify:sourcify": "VERIFY_SOURCIFY=true VERIFY_ETHERSCAN=false yarn hardhat verify",
    "dump:roles": "yarn hh:run scripts/dump_roles.ts",
    "verify:all:impl": "yarn hh:run:script scripts/verify_contracts.ts",
    "oz:resolve-manifest-conflicts": "ts-node scripts/merge-oz-manifests.ts"
  },
  "devDependencies": {
    "@axelar-network/axelar-local-dev": "2.3.3",
    "@axelar-network/axelarjs-sdk": "0.17.9",
    "@axelar-network/interchain-token-service": "2.2.0",
    "@chainlink/contracts": "0.6.1",
    "@clack/prompts": "0.11.0",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "17.1.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@ethersproject/abi": "5.7.0",
    "@ethersproject/providers": "5.7.2",
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.146",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.139",
    "@layerzerolabs/metadata-tools": "3.0.2",
    "@layerzerolabs/oapp-evm": "0.3.2",
    "@layerzerolabs/oft-evm": "3.2.1",
    "@layerzerolabs/toolbox-hardhat": "0.6.12",
    "@nomicfoundation/hardhat-chai-matchers": "1.0.4",
    "@nomicfoundation/hardhat-network-helpers": "1.0.6",
    "@nomicfoundation/hardhat-toolbox": "1.0.2",
    "@nomicfoundation/hardhat-verify": "2.0.14",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@openzeppelin/contracts": "4.8.3",
    "@openzeppelin/contracts-upgradeable": "4.9.0",
    "@openzeppelin/hardhat-upgrades": "1.27.0",
    "@safe-global/safe-core-sdk-types": "5.1.0",
    "@typechain/ethers-v5": "10.1.0",
    "@typechain/hardhat": "6.1.3",
    "@types/mocha": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "chai": "4.3.6",
    "chalk": "4.1.2",
    "cross-env": "7.0.3",
    "dotenv": "16.0.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "15.3.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "ethers": "5.7.2",
    "globals": "16.5.0",
    "hardhat": "2.25.0",
    "hardhat-contract-sizer": "2.6.1",
    "hardhat-deploy": "0.11.19",
    "hardhat-docgen": "1.3.0",
    "hardhat-gas-reporter": "1.0.9",
    "hardhat-tracer": "3.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "npm-run-all2": "6.2.0",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "1.0.0-beta.24",
    "solhint": "3.3.7",
    "solidity-bytes-utils": "0.8.4",
    "solidity-coverage": "0.8.16",
    "solidity-docgen": "0.6.0-beta.35",
    "ts-morph": "26.0.0",
    "ts-node": "10.9.1",
    "typechain": "8.1.0",
    "typescript": "4.8.4",
    "typescript-eslint": "8.46.4"
  },
  "resolutions": {
    "@layerzerolabs/oft-evm/@openzeppelin/contracts": "4.8.3"
  },
  "packageManager": "yarn@4.10.3",
  "lint-staged": {
    "*.{js,ts}": [
      "yarn lint:ts:fix ",
      "yarn format:ts:fix"
    ],
    "*.{json,yml,yaml}": [
      "yarn format:yml:fix"
    ],
    "*.sol": [
      "yarn lint:sol:fix",
      "yarn format:sol:fix"
    ]
  }
}
